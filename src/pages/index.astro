---
import { parseDiscordMarkdown } from '../utils/discordMarkdown';

const initialMarkdown = `Hello world, welcome to the Discord bot hub.`;
const initialHtml = parseDiscordMarkdown(initialMarkdown);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="https://darketomaly.com/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>Discord Bot Hub</title>
		<style>
			:root {
				--bg-app: #1e1f22;
				--bg-header: #2b2d31;
				--bg-editor: #313338;
				--bg-preview: #313338;
				--bg-input: #383a40;
				--text-normal: #dbdee1;
				--text-muted: #949ba4;
				--text-header: #f2f3f5;
				--text-link: #00a8fc;
				--code-bg: #2b2d31;
				--quote-border: #4e5058;
				--spoiler-bg: #242429;
				--spoiler-revealed: #2b2d31;
				--border-color: #1f2023;
				--accent: #5865f2;
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			/* Discord-style Custom Scrollbar */
			* {
				scrollbar-width: thin;
				scrollbar-color: #1a1b1e #2b2d31;
			}

			*::-webkit-scrollbar {
				width: 8px;
				height: 8px;
			}

			*::-webkit-scrollbar-track {
				background-color: #2b2d31;
				border-radius: 4px;
			}

			*::-webkit-scrollbar-thumb {
				background-color: #1a1b1e;
				border-radius: 4px;
				border: 2px solid #2b2d31;
			}

			*::-webkit-scrollbar-thumb:hover {
				background-color: #111214;
			}

			*::-webkit-scrollbar-corner {
				background-color: transparent;
			}

			body {
				font-family: "gg sans", "Noto Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
				background-color: var(--bg-app);
				color: var(--text-normal);
				display: flex;
				flex-direction: column;
				height: 100vh;
				overflow: hidden;
			}

			header {
				background-color: var(--bg-header);
				padding: 12px 24px;
				display: flex;
				align-items: center;
				justify-content: space-between;
				border-bottom: 1px solid var(--border-color);
				box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
			}

			header h1 {
				font-size: 1.15rem;
				font-weight: 700;
				color: var(--text-header);
				display: flex;
				align-items: center;
				gap: 10px;
			}

			.badge {
				background-color: var(--accent);
				color: #fff;
				font-size: 0.75rem;
				padding: 2px 8px;
				border-radius: 12px;
				font-weight: 600;
			}

			.auth-section {
				display: flex;
				align-items: center;
				gap: 12px;
			}

			.btn-login,
			.btn-invite {
				box-sizing: border-box;
				height: 36px;
				padding: 0 14px;
				font-size: 0.85rem;
				font-weight: 600;
				line-height: 1;
				border-radius: 4px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 8px;
				cursor: pointer;
				text-decoration: none;
				transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
			}

			.btn-login {
				background-color: var(--accent);
				color: #fff;
				border: 1px solid transparent;
			}

			.btn-login:hover {
				background-color: #4752c4;
			}

			.btn-invite {
				background-color: rgba(255, 255, 255, 0.05);
				color: var(--text-normal);
				border: 1px solid rgba(255, 255, 255, 0.18);
			}

			.btn-invite:hover {
				background-color: rgba(255, 255, 255, 0.1);
				border-color: rgba(255, 255, 255, 0.35);
				color: #fff;
			}

			.user-chip {
				height: 36px;
				box-sizing: border-box;
				display: flex;
				align-items: center;
				gap: 8px;
				background-color: var(--bg-editor);
				padding: 0 10px 0 6px;
				border-radius: 18px;
				font-size: 0.85rem;
				border: 1px solid rgba(255, 255, 255, 0.08);
			}

			.user-avatar {
				width: 26px;
				height: 26px;
				border-radius: 50%;
				background-color: var(--accent);
			}

			.btn-logout {
				background: transparent;
				border: none;
				color: var(--text-muted);
				cursor: pointer;
				font-size: 0.75rem;
				padding: 2px 4px;
				margin-left: 4px;
			}

			.btn-logout:hover {
				color: #e74c3c;
			}

			.main-container {
				flex: 1;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 16px;
				padding: 16px;
				min-height: 0;
			}

			@media (max-width: 768px) {
				.main-container {
					grid-template-columns: 1fr;
					grid-template-rows: 1fr 1fr;
				}
			}

			.panel {
				background-color: var(--bg-editor);
				border-radius: 8px;
				display: flex;
				flex-direction: column;
				overflow: hidden;
				box-shadow: 0 4px 6px rgba(0, 0, 0, 0.15);
				border: 1px solid rgba(255, 255, 255, 0.05);
			}

			.panel-header {
				background-color: var(--bg-header);
				padding: 10px 16px;
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--text-muted);
				text-transform: uppercase;
				letter-spacing: 0.5px;
				display: flex;
				align-items: center;
				justify-content: space-between;
				border-bottom: 1px solid var(--border-color);
			}

			.panel-title {
				display: flex;
				align-items: center;
				gap: 8px;
			}

			.editor-wrapper {
				flex: 1;
				display: flex;
				flex-direction: column;
				padding: 12px;
				gap: 12px;
				min-height: 0;
			}

			.action-bar {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 10px;
				background-color: var(--bg-header);
				padding: 10px 14px;
				border-radius: 6px;
				border: 1px solid rgba(255, 255, 255, 0.05);
			}

			.select-wrapper {
				flex: 1;
				min-width: 200px;
				display: flex;
				align-items: center;
				gap: 8px;
			}

			.select-label {
				font-size: 0.8rem;
				font-weight: 600;
				color: var(--text-muted);
				white-space: nowrap;
			}

			#channel-select {
				flex: 1;
				background-color: var(--bg-input);
				color: var(--text-normal);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 4px;
				padding: 8px 10px;
				font-size: 0.88rem;
				outline: none;
				cursor: pointer;
			}

			#channel-select:focus {
				border-color: var(--accent);
			}

			.message-id-wrapper {
				display: flex;
				align-items: center;
				gap: 8px;
			}

			.input-message-id {
				width: 170px;
				background-color: var(--bg-input);
				color: var(--text-normal);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 4px;
				padding: 8px 10px;
				font-size: 0.85rem;
				outline: none;
			}

			.input-message-id:focus {
				border-color: var(--accent);
			}

			.btn-load {
				background-color: rgba(255, 255, 255, 0.08);
				color: var(--text-normal);
				border: 1px solid rgba(255, 255, 255, 0.15);
				border-radius: 4px;
				padding: 8px 12px;
				font-size: 0.82rem;
				font-weight: 500;
				cursor: pointer;
				transition: all 0.15s ease;
			}

			.btn-load:hover:not(:disabled) {
				background-color: rgba(255, 255, 255, 0.15);
				color: #fff;
			}

			.btn-load:disabled {
				opacity: 0.5;
				cursor: not-allowed;
			}

			.edit-mode-indicator {
				display: none;
				align-items: center;
				justify-content: space-between;
				width: 100%;
				background: rgba(88, 101, 242, 0.15);
				border: 1px solid rgba(88, 101, 242, 0.35);
				border-radius: 4px;
				padding: 6px 10px;
				font-size: 0.82rem;
				color: #c9cdfb;
			}

			.edit-cancel-btn {
				background: transparent;
				color: var(--text-muted);
				border: none;
				font-size: 0.78rem;
				cursor: pointer;
				text-decoration: underline;
				padding: 0 4px;
			}

			.edit-cancel-btn:hover {
				color: #fff;
			}

			.file-input-wrapper {
				width: 100%;
				display: flex;
				align-items: center;
				gap: 10px;
			}

			.btn-file-choose {
				background-color: rgba(255, 255, 255, 0.08);
				color: var(--text-normal);
				border: 1px solid rgba(255, 255, 255, 0.15);
				border-radius: 4px;
				padding: 7px 12px;
				font-size: 0.82rem;
				font-weight: 500;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				gap: 6px;
				transition: all 0.15s ease;
			}

			.btn-file-choose:hover {
				background-color: rgba(255, 255, 255, 0.15);
				color: #fff;
			}

			.file-name-display {
				flex: 1;
				font-size: 0.82rem;
				color: var(--text-muted);
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			.image-clear-btn {
				background: transparent;
				color: var(--text-muted);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 4px;
				padding: 7px 10px;
				font-size: 0.82rem;
				cursor: pointer;
				transition: all 0.15s ease;
				display: none;
			}

			.image-clear-btn:hover {
				color: #e74c3c;
				border-color: rgba(231, 76, 60, 0.4);
			}

			.btn-refresh {
				background-color: transparent;
				color: var(--text-muted);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 4px;
				padding: 8px 12px;
				font-size: 0.82rem;
				cursor: pointer;
				transition: all 0.15s ease;
			}

			.btn-refresh:hover {
				color: var(--text-header);
				background-color: rgba(255, 255, 255, 0.05);
			}

			.btn-send {
				background-color: var(--accent);
				color: #fff;
				border: none;
				border-radius: 4px;
				padding: 8px 18px;
				font-size: 0.88rem;
				font-weight: 600;
				cursor: pointer;
				transition: opacity 0.15s ease, background-color 0.15s ease;
				display: flex;
				align-items: center;
				gap: 6px;
			}

			.btn-send:hover:not(:disabled) {
				background-color: #4752c4;
			}

			.btn-send:disabled {
				opacity: 0.5;
				cursor: not-allowed;
			}

			.status-bar {
				width: 100%;
				font-size: 0.85rem;
				padding: 8px 12px;
				border-radius: 6px;
				display: none;
				word-break: break-all;
			}

			.status-bar.info {
				display: block;
				background-color: rgba(88, 101, 242, 0.15);
				color: #dbdee1;
				border: 1px solid rgba(88, 101, 242, 0.3);
			}

			.status-bar.success {
				display: block;
				background-color: rgba(46, 204, 113, 0.15);
				color: #2ecc71;
				border: 1px solid rgba(46, 204, 113, 0.3);
			}

			.status-bar.error {
				display: block;
				background-color: rgba(231, 76, 60, 0.15);
				color: #e74c3c;
				border: 1px solid rgba(231, 76, 60, 0.3);
			}

			.input-box-wrapper {
				width: 100%;
				flex: 1;
				display: flex;
				flex-direction: column;
				min-height: 0;
				background-color: var(--bg-input);
				border: 1px solid rgba(255, 255, 255, 0.05);
				border-radius: 6px;
				overflow: hidden;
				transition: border-color 0.15s ease;
			}

			.input-box-wrapper:focus-within {
				border-color: var(--accent);
			}

			.text-utility-bar {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 3px;
				padding: 6px 10px;
				background-color: var(--bg-header);
				border-bottom: 1px solid rgba(255, 255, 255, 0.06);
				user-select: none;
				flex-shrink: 0;
			}

			.util-btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-width: 28px;
				height: 28px;
				padding: 0 6px;
				background-color: transparent;
				color: var(--text-muted);
				border: 1px solid transparent;
				border-radius: 4px;
				font-size: 0.82rem;
				font-weight: 600;
				cursor: pointer;
				transition: background-color 0.12s ease, color 0.12s ease;
			}

			.util-btn:hover {
				background-color: rgba(255, 255, 255, 0.08);
				color: var(--text-header);
			}

			.util-btn:active {
				background-color: rgba(88, 101, 242, 0.25);
				color: #fff;
			}

			.util-divider {
				width: 1px;
				height: 18px;
				background-color: rgba(255, 255, 255, 0.08);
				margin: 0 4px;
				align-self: center;
			}

			#markdown-input {
				width: 100%;
				flex: 1;
				min-height: 0;
				background-color: transparent;
				color: var(--text-normal);
				border: none;
				border-radius: 0;
				padding: 14px;
				font-family: "Consolas", "Courier New", Courier, monospace;
				font-size: 0.92rem;
				line-height: 1.5;
				resize: none;
				outline: none;
			}

			.preview-wrapper {
				flex: 1;
				padding: 16px;
				overflow-y: auto;
				background-color: var(--bg-preview);
				font-size: 0.95rem;
				line-height: 1.45;
				word-break: break-word;
			}

			/* Discord Message Styling */
			:global(.discord-h1) {
				font-size: 1.5rem;
				font-weight: 700;
				color: var(--text-header);
				margin: 12px 0 6px 0;
			}

			:global(.discord-h2) {
				font-size: 1.25rem;
				font-weight: 700;
				color: var(--text-header);
				margin: 10px 0 4px 0;
			}

			:global(.discord-h3) {
				font-size: 1.05rem;
				font-weight: 700;
				color: var(--text-header);
				margin: 8px 0 4px 0;
			}

			:global(.discord-subtext) {
				color: var(--text-muted);
				font-size: 0.8rem;
				display: block;
				margin: 2px 0;
			}

			:global(.discord-quote) {
				border-left: 4px solid var(--quote-border);
				padding-left: 12px;
				margin: 4px 0;
				color: var(--text-normal);
			}

			:global(.discord-inline-code) {
				background-color: var(--code-bg);
				padding: 2px 5px;
				border-radius: 4px;
				font-family: "Consolas", monospace;
				font-size: 0.88em;
				color: var(--text-normal);
			}

			:global(.discord-code-block) {
				background-color: var(--code-bg);
				border: 1px solid rgba(0, 0, 0, 0.2);
				border-radius: 6px;
				padding: 10px 12px;
				margin: 8px 0;
				overflow-x: auto;
				font-family: "Consolas", monospace;
				font-size: 0.88em;
				color: var(--text-normal);
				line-height: 1.4;
			}

			:global(.discord-link) {
				color: var(--text-link);
				text-decoration: none;
			}

			:global(.discord-link:hover) {
				text-decoration: underline;
			}

			.preview-attachment {
				margin-top: 12px;
				display: none;
				max-width: 100%;
			}

			.preview-attachment img {
				max-width: 100%;
				max-height: 300px;
				border-radius: 8px;
				border: 1px solid rgba(255, 255, 255, 0.1);
				object-fit: contain;
			}

			:global(.discord-spoiler) {
				background-color: var(--spoiler-bg);
				color: transparent;
				border-radius: 3px;
				padding: 1px 4px;
				cursor: pointer;
				user-select: none;
				transition: background-color 0.1s ease, color 0.1s ease;
			}

			:global(.discord-spoiler.revealed) {
				background-color: var(--spoiler-revealed);
				color: var(--text-normal);
				cursor: text;
				user-select: text;
			}
		</style>
	</head>
	<body>
		<header>
			<div style="display: flex; align-items: center; gap: 10px;">
				<h1>Discord Bot Hub</h1>
				<span class="badge">1.0.0</span>
			</div>
			<div class="auth-section">
				<a
					href="https://api.darketomaly.com/install-discord-bot"
					target="_blank"
					rel="noopener noreferrer"
					class="btn-invite"
					title="Invite Bot to your server"
				>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
						<circle cx="8.5" cy="7.5" r="4"></circle>
						<line x1="20" y1="8" x2="20" y2="14"></line>
						<line x1="23" y1="11" x2="17" y2="11"></line>
					</svg>
					<span>Invite Bot</span>
				</a>
				<button type="button" id="login-btn" class="btn-login" style="display: none;">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
						<path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
					</svg>
					<span>Log in with Discord</span>
				</button>
				<div id="user-chip" class="user-chip" style="display: none;">
					<img id="user-avatar" class="user-avatar" src="" alt="avatar" />
					<span id="user-name">User</span>
					<button type="button" id="logout-btn" class="btn-logout" title="Log out">✕</button>
				</div>
			</div>
		</header>

		<main class="main-container">
			<section class="panel">
				<div class="panel-header">
					<span>Write (Input)</span>
					<span id="char-count">0 characters</span>
				</div>
				<div class="editor-wrapper">
					<div class="action-bar">
						<div class="select-wrapper">
							<label for="channel-select" class="select-label">Channel:</label>
							<select id="channel-select" disabled>
								<option value="">Loading channels...</option>
							</select>
							<button type="button" id="refresh-btn" class="btn-refresh" title="Reload channels">↻</button>
						</div>
						<div class="message-id-wrapper">
							<input
								type="text"
								id="message-id-input"
								class="input-message-id"
								placeholder="Message ID (optional)"
								title="Enter a Discord Message ID to load and edit"
							/>
							<button type="button" id="load-msg-btn" class="btn-load" title="Load message content">Load</button>
						</div>
						<button type="button" id="send-btn" class="btn-send" disabled>
							<span>Send Message</span>
						</button>
						<div id="edit-mode-indicator" class="edit-mode-indicator">
							<span>Editing message: <strong id="editing-message-id"></strong></span>
							<button type="button" id="cancel-edit-btn" class="edit-cancel-btn">Cancel (New Message)</button>
						</div>
						<div class="file-input-wrapper">
							<input
								type="file"
								id="image-file-input"
								accept="image/*"
								style="display: none;"
							/>
							<button type="button" id="file-choose-btn" class="btn-file-choose">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
									<circle cx="8.5" cy="8.5" r="1.5"></circle>
									<polyline points="21 15 16 10 5 21"></polyline>
								</svg>
								<span>Attach Image</span>
							</button>
							<span id="file-name-display" class="file-name-display">No image selected</span>
							<button type="button" id="image-clear-btn" class="image-clear-btn" title="Remove attachment">✕</button>
						</div>
						<div id="status-msg" class="status-bar"></div>
					</div>

					<div class="input-box-wrapper">
						<div id="text-utility-bar" class="text-utility-bar" role="toolbar" aria-label="Discord Markdown Utilities">
							<button type="button" class="util-btn" data-format="bold" title="Bold (**text**) — Ctrl+B" aria-label="Bold">
								<strong style="font-size: 0.95rem; font-family: serif;">B</strong>
