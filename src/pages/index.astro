---
import { parseDiscordMarkdown } from '../utils/discordMarkdown';

const initialMarkdown = `Hello **world**! Welcome to the Discord markdown previewer.

Here are some examples of what you can type:
- **Bold text** with \`**bold**\`
- *Italic text* with \`*italic*\` or _italic_ with \`_italic_\`
- ***Bold & Italic*** with \`***text***\`
- __Underlined text__ with \`__text__\`
- ~~Strikethrough~~ with \`~~text~~\`
- ||Spoiler alert: Click to reveal!|| with \`||spoiler||\`
- Inline code like \`const x = 42;\`
- Subtext with -# small details:
-# This is quiet subtext!

### Headers
# Big Header (H1)
## Medium Header (H2)
### Small Header (H3)

> Single line blockquote
> Second line of quote

\`\`\`javascript
function greet(name) {
  console.log("Hello, " + name + "!");
}
\`\`\`

Check out [Astro](https://astro.build) or raw link https://discord.com!`;

const initialHtml = parseDiscordMarkdown(initialMarkdown);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>Discord Markdown Previewer</title>
		<style>
			:root {
				--bg-app: #1e1f22;
				--bg-header: #2b2d31;
				--bg-editor: #313338;
				--bg-preview: #313338;
				--bg-input: #383a40;
				--text-normal: #dbdee1;
				--text-muted: #949ba4;
				--text-header: #f2f3f5;
				--text-link: #00a8fc;
				--code-bg: #2b2d31;
				--quote-border: #4e5058;
				--spoiler-bg: #242429;
				--spoiler-revealed: #2b2d31;
				--border-color: #1f2023;
				--accent: #5865f2;
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family: "gg sans", "Noto Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
				background-color: var(--bg-app);
				color: var(--text-normal);
				display: flex;
				flex-direction: column;
				height: 100vh;
				overflow: hidden;
			}

			header {
				background-color: var(--bg-header);
				padding: 12px 24px;
				display: flex;
				align-items: center;
				justify-content: space-between;
				border-bottom: 1px solid var(--border-color);
				box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
			}

			header h1 {
				font-size: 1.15rem;
				font-weight: 700;
				color: var(--text-header);
				display: flex;
				align-items: center;
				gap: 10px;
			}

			header .badge {
				background-color: var(--accent);
				color: #fff;
				font-size: 0.75rem;
				padding: 2px 8px;
				border-radius: 12px;
				font-weight: 600;
			}

			.auth-section {
				display: flex;
				align-items: center;
				gap: 12px;
			}

			.btn-login {
				background-color: var(--accent);
				color: #fff;
				border: none;
				border-radius: 4px;
				padding: 6px 14px;
				font-size: 0.85rem;
				font-weight: 600;
				cursor: pointer;
				display: flex;
				align-items: center;
				gap: 6px;
				text-decoration: none;
				transition: background-color 0.15s ease;
			}

			.btn-login:hover {
				background-color: #4752c4;
			}

			.btn-ping {
				background-color: transparent;
				color: var(--text-muted);
				border: 1px solid rgba(255, 255, 255, 0.15);
				border-radius: 4px;
				padding: 6px 12px;
				font-size: 0.82rem;
				cursor: pointer;
				transition: all 0.15s ease;
			}

			.btn-ping:hover {
				color: var(--text-header);
				border-color: rgba(255, 255, 255, 0.3);
			}

			.user-chip {
				display: flex;
				align-items: center;
				gap: 8px;
				background-color: var(--bg-editor);
				padding: 4px 10px 4px 6px;
				border-radius: 20px;
				font-size: 0.85rem;
				border: 1px solid rgba(255, 255, 255, 0.08);
			}

			.user-avatar {
				width: 26px;
				height: 26px;
				border-radius: 50%;
				background-color: var(--accent);
			}

			.btn-logout {
				background: transparent;
				border: none;
				color: var(--text-muted);
				cursor: pointer;
				font-size: 0.75rem;
				padding: 2px 4px;
				margin-left: 4px;
			}

			.btn-logout:hover {
				color: #e74c3c;
			}

			.main-container {
				flex: 1;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 16px;
				padding: 16px;
				min-height: 0;
			}

			@media (max-width: 768px) {
				.main-container {
					grid-template-columns: 1fr;
					grid-template-rows: 1fr 1fr;
				}
			}

			.panel {
				background-color: var(--bg-editor);
				border-radius: 8px;
				display: flex;
				flex-direction: column;
				overflow: hidden;
				box-shadow: 0 4px 6px rgba(0, 0, 0, 0.15);
				border: 1px solid rgba(255, 255, 255, 0.05);
			}

			.panel-header {
				background-color: var(--bg-header);
				padding: 10px 16px;
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--text-muted);
				text-transform: uppercase;
				letter-spacing: 0.5px;
				display: flex;
				align-items: center;
				justify-content: space-between;
				border-bottom: 1px solid var(--border-color);
			}

			.editor-wrapper {
				flex: 1;
				display: flex;
				flex-direction: column;
				padding: 12px;
				gap: 12px;
				min-height: 0;
			}

			.action-bar {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 10px;
				background-color: var(--bg-header);
				padding: 10px 14px;
				border-radius: 6px;
				border: 1px solid rgba(255, 255, 255, 0.05);
			}

			.select-wrapper {
				flex: 1;
				min-width: 200px;
				display: flex;
				align-items: center;
				gap: 8px;
			}

			.select-label {
				font-size: 0.8rem;
				font-weight: 600;
				color: var(--text-muted);
				white-space: nowrap;
			}

			#channel-select {
				flex: 1;
				background-color: var(--bg-input);
				color: var(--text-normal);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 4px;
				padding: 8px 10px;
				font-size: 0.88rem;
				outline: none;
				cursor: pointer;
			}

			#channel-select:focus {
				border-color: var(--accent);
			}

			.btn-refresh {
				background-color: transparent;
				color: var(--text-muted);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 4px;
				padding: 8px 12px;
				font-size: 0.82rem;
				cursor: pointer;
				transition: all 0.15s ease;
			}

			.btn-refresh:hover {
				color: var(--text-header);
				background-color: rgba(255, 255, 255, 0.05);
			}

			.btn-send {
				background-color: var(--accent);
				color: #fff;
				border: none;
				border-radius: 4px;
				padding: 8px 18px;
				font-size: 0.88rem;
				font-weight: 600;
				cursor: pointer;
				transition: opacity 0.15s ease, background-color 0.15s ease;
				display: flex;
				align-items: center;
				gap: 6px;
			}

			.btn-send:hover:not(:disabled) {
				background-color: #4752c4;
			}

			.btn-send:disabled {
				opacity: 0.5;
				cursor: not-allowed;
			}

			.status-bar {
				width: 100%;
				font-size: 0.85rem;
				padding: 8px 12px;
				border-radius: 6px;
				display: none;
				word-break: break-all;
			}

			.status-bar.info {
				display: block;
				background-color: rgba(88, 101, 242, 0.15);
				color: #dbdee1;
				border: 1px solid rgba(88, 101, 242, 0.3);
			}

			.status-bar.success {
				display: block;
				background-color: rgba(46, 204, 113, 0.15);
				color: #2ecc71;
				border: 1px solid rgba(46, 204, 113, 0.3);
			}

			.status-bar.error {
				display: block;
				background-color: rgba(231, 76, 60, 0.15);
				color: #e74c3c;
				border: 1px solid rgba(231, 76, 60, 0.3);
			}

			#markdown-input {
				width: 100%;
				flex: 1;
				background-color: var(--bg-input);
				color: var(--text-normal);
				border: 1px solid transparent;
				border-radius: 6px;
				padding: 14px;
				font-family: "Consolas", "Courier New", Courier, monospace;
				font-size: 0.92rem;
				line-height: 1.5;
				resize: none;
				outline: none;
				transition: border-color 0.15s ease;
			}

			#markdown-input:focus {
				border-color: var(--accent);
			}

			.preview-wrapper {
				flex: 1;
				padding: 16px;
				overflow-y: auto;
				background-color: var(--bg-preview);
				font-size: 0.95rem;
				line-height: 1.45;
				word-break: break-word;
			}

			/* Discord Message Styling */
			:global(.discord-h1) {
				font-size: 1.5rem;
				font-weight: 700;
				color: var(--text-header);
				margin: 12px 0 6px 0;
			}

			:global(.discord-h2) {
				font-size: 1.25rem;
				font-weight: 700;
				color: var(--text-header);
				margin: 10px 0 4px 0;
			}

			:global(.discord-h3) {
				font-size: 1.05rem;
				font-weight: 700;
				color: var(--text-header);
				margin: 8px 0 4px 0;
			}

			:global(.discord-subtext) {
				color: var(--text-muted);
				font-size: 0.8rem;
				display: block;
				margin: 2px 0;
			}

			:global(.discord-quote) {
				border-left: 4px solid var(--quote-border);
				padding-left: 12px;
				margin: 4px 0;
				color: var(--text-normal);
			}

			:global(.discord-inline-code) {
				background-color: var(--code-bg);
				padding: 2px 5px;
				border-radius: 4px;
				font-family: "Consolas", monospace;
				font-size: 0.88em;
				color: var(--text-normal);
			}

			:global(.discord-code-block) {
				background-color: var(--code-bg);
				border: 1px solid rgba(0, 0, 0, 0.2);
				border-radius: 6px;
				padding: 10px 12px;
				margin: 8px 0;
				overflow-x: auto;
				font-family: "Consolas", monospace;
				font-size: 0.88em;
				color: var(--text-normal);
				line-height: 1.4;
			}

			:global(.discord-link) {
				color: var(--text-link);
				text-decoration: none;
			}

			:global(.discord-link:hover) {
				text-decoration: underline;
			}

			:global(.discord-spoiler) {
				background-color: var(--spoiler-bg);
				color: transparent;
				border-radius: 3px;
				padding: 1px 4px;
				cursor: pointer;
				user-select: none;
				transition: background-color 0.1s ease, color 0.1s ease;
			}

			:global(.discord-spoiler.revealed) {
				background-color: var(--spoiler-revealed);
				color: var(--text-normal);
				cursor: text;
				user-select: text;
			}
		</style>
	</head>
	<body>
		<header>
			<div style="display: flex; align-items: center; gap: 10px;">
				<h1>Discord Markdown Previewer</h1>
				<span class="badge">Live Preview</span>
			</div>
			<div class="auth-section">
				<button type="button" id="ping-btn" class="btn-ping" title="Test connection to backend">
					📡 Ping Backend
				</button>
				<button type="button" id="login-btn" class="btn-login" style="display: none;">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
						<path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
					</svg>
					<span>Log in with Discord</span>
				</button>
				<div id="user-chip" class="user-chip" style="display: none;">
					<img id="user-avatar" class="user-avatar" src="" alt="avatar" />
					<span id="user-name">User</span>
					<button type="button" id="logout-btn" class="btn-logout" title="Log out">✕</button>
				</div>
			</div>
		</header>

		<main class="main-container">
			<section class="panel">
				<div class="panel-header">
					<span>Write (Input)</span>
					<span id="char-count">0 characters</span>
				</div>
				<div class="editor-wrapper">
					<div class="action-bar">
						<div class="select-wrapper">
							<label for="channel-select" class="select-label">Channel:</label>
							<select id="channel-select" disabled>
								<option value="">Loading channels...</option>
							</select>
							<button type="button" id="refresh-btn" class="btn-refresh" title="Reload channels">↻</button>
						</div>
						<button type="button" id="send-btn" class="btn-send" disabled>
							<span>Send Message</span>
						</button>
						<div id="status-msg" class="status-bar"></div>
					</div>

					<textarea
						id="markdown-input"
						placeholder="Type Discord markdown here..."
						spellcheck="false"
					>{initialMarkdown}</textarea>
				</div>
			</section>

			<section class="panel">
				<div class="panel-header">
					<span>Read (Discord Preview)</span>
					<span>Formatted</span>
				</div>
				<div class="preview-wrapper" id="markdown-output" set:html={initialHtml}></div>
			</section>
		</main>

		<script>
			import { parseDiscordMarkdown } from '../utils/discordMarkdown';

			const input = document.getElementById('markdown-input') as HTMLTextAreaElement | null;
			const output = document.getElementById('markdown-output');
			const charCount = document.getElementById('char-count');
			const channelSelect = document.getElementById('channel-select') as HTMLSelectElement | null;
			const refreshBtn = document.getElementById('refresh-btn') as HTMLButtonElement | null;
			const sendBtn = document.getElementById('send-btn') as HTMLButtonElement | null;
			const statusMsg = document.getElementById('status-msg');

			const pingBtn = document.getElementById('ping-btn') as HTMLButtonElement | null;
			const loginBtn = document.getElementById('login-btn') as HTMLButtonElement | null;
			const userChip = document.getElementById('user-chip');
			const userAvatar = document.getElementById('user-avatar') as HTMLImageElement | null;
			const userName = document.getElementById('user-name');
			const logoutBtn = document.getElementById('logout-btn') as HTMLButtonElement | null;

			// Fixed API backend URL
			const BACKEND_BASE_URL = 'https://api.darketomaly.com';

			function getBackendBaseUrl(): string {
				return BACKEND_BASE_URL;
			}

			function setStatus(text: string, type: 'info' | 'success' | 'error' = 'info', autoClear = true) {
				if (!statusMsg) return;
				statusMsg.className = `status-bar ${type}`;
				statusMsg.textContent = text;
				statusMsg.style.display = 'block';

				if (autoClear && type !== 'info') {
					setTimeout(() => {
						if (statusMsg.textContent === text) {
							statusMsg.style.display = 'none';
						}
					}, 4000);
				}
			}

			function getStoredUser() {
				const token = localStorage.getItem('discord_user_token');
				const profileStr = localStorage.getItem('discord_user_profile');
				if (!token || !profileStr) return null;
				try {
					return { token, profile: JSON.parse(profileStr) };
				} catch {
					return null;
				}
			}

			function updateAuthUI() {
				const user = getStoredUser();
				if (user) {
					if (loginBtn) loginBtn.style.display = 'none';
					if (userChip) userChip.style.display = 'flex';
					if (userName) userName.textContent = user.profile.global_name || user.profile.username || 'Discord User';
					if (userAvatar) {
						if (user.profile.avatar) {
							userAvatar.src = `https://cdn.discordapp.com/avatars/${user.profile.id}/${user.profile.avatar}.png?size=64`;
						} else {
							userAvatar.src = 'https://cdn.discordapp.com/embed/avatars/0.png';
						}
					}
				} else {
					if (loginBtn) loginBtn.style.display = 'flex';
					if (userChip) userChip.style.display = 'none';
				}
			}

			async function startLogin() {
				const baseUrl = getBackendBaseUrl();
				const redirectUri = window.location.origin + '/auth/callback';
				setStatus('Getting Discord authorization URL...', 'info', false);

				try {
					const targetUrl = `${baseUrl}/discord/auth/url?redirect_uri=${encodeURIComponent(redirectUri)}`;
					const res = await fetch(targetUrl);
					const data = await res.json().catch(() => ({}));
					if (!res.ok || !data.url) {
						throw new Error(data.error || `HTTP ${res.status} from ${targetUrl}`);
					}
					window.location.href = data.url;
				} catch (err: any) {
					console.error('Login error:', err);
					const msg = err.name === 'TypeError'
						? `CORS / Network Error: Could not reach ${baseUrl}/discord/auth/url`
						: err.message;
					setStatus(`OAuth Error: ${msg}`, 'error', false);
				}
			}

			function logout() {
				localStorage.removeItem('discord_user_token');
				localStorage.removeItem('discord_user_profile');
				updateAuthUI();
				loadChannels();
			}

			async function loadChannels() {
				if (!channelSelect) return;
				channelSelect.disabled = true;
				channelSelect.innerHTML = '<option value="">Loading channels...</option>';
				const baseUrl = getBackendBaseUrl();
				const user = getStoredUser();

				// If user is logged in, fetch channels permitted for this user
				const endpoint = user ? `${baseUrl}/discord/user-channels` : `${baseUrl}/discord/channels`;
				const headers: Record<string, string> = {};
				if (user) {
					headers['Authorization'] = `Bearer ${user.token}`;
					setStatus(`Loading channels for @${user.profile.username}...`, 'info', false);
				} else {
					setStatus(`Connecting to ${baseUrl}...`, 'info', false);
				}

				try {
					const res = await fetch(endpoint, { headers });
					if (res.status === 401 && user) {
						// Token expired or invalid
						logout();
						throw new Error('Discord login expired. Please log in again.');
					}

					if (!res.ok) {
						const errData = await res.json().catch(() => ({}));
						throw new Error(errData.error || `HTTP ${res.status} (${res.statusText || 'Error'})`);
					}

					const guilds = await res.json();
					channelSelect.innerHTML = '';

					if (!Array.isArray(guilds) || guilds.length === 0) {
						channelSelect.innerHTML = '<option value="">No servers available</option>';
						const msg = user
							? 'No servers found where both you and the bot have permission'
							: 'Bot has no servers or is starting up';
						setStatus(msg, 'error', false);
						return;
					}

					const defaultOpt = document.createElement('option');
					defaultOpt.value = '';
					defaultOpt.textContent = '-- Select a channel --';
					channelSelect.appendChild(defaultOpt);

					let totalChannels = 0;
					guilds.forEach((guild: any) => {
						const optgroup = document.createElement('optgroup');
						optgroup.label = guild.name;

						guild.channels?.forEach((channel: any) => {
							totalChannels++;
							const opt = document.createElement('option');
							opt.value = channel.id;
							const categoryPrefix = channel.category ? `[${channel.category}] ` : '';
							opt.textContent = `# ${categoryPrefix}${channel.name}`;
							optgroup.appendChild(opt);
						});

						channelSelect.appendChild(optgroup);
					});

					channelSelect.disabled = false;
					setStatus(`✓ Connected: Loaded ${guilds.length} servers & ${totalChannels} channels`, 'success');
					updateSendButtonState();
				} catch (err: any) {
					channelSelect.innerHTML = '<option value="">Failed to connect</option>';
					const detail = err.name === 'TypeError'
						? `CORS / Network Error: Could not reach ${baseUrl}`
						: err.message;
					setStatus(`Error: ${detail}`, 'error', false);
					updateSendButtonState();
				}
			}

			function updateSendButtonState() {
				if (!sendBtn || !channelSelect || !input) return;
				const hasChannel = Boolean(channelSelect.value);
				const hasText = input.value.trim().length > 0;
				sendBtn.disabled = !hasChannel || !hasText;
			}

			async function sendMessage() {
				if (!channelSelect?.value || !input?.value.trim()) return;
				if (!sendBtn) return;

				const channelId = channelSelect.value;
				const content = input.value;
				const baseUrl = getBackendBaseUrl();
				const user = getStoredUser();

				sendBtn.disabled = true;
				sendBtn.textContent = 'Sending...';
				setStatus('Sending message to Discord...', 'info', false);

				try {
					const headers: Record<string, string> = { 'Content-Type': 'application/json' };
					if (user) {
						headers['Authorization'] = `Bearer ${user.token}`;
					}

					const res = await fetch(`${baseUrl}/discord/send`, {
						method: 'POST',
						headers,
						body: JSON.stringify({ channelId, content })
					});

					const result = await res.json().catch(() => ({}));
					if (!res.ok) {
						throw new Error(result.error || `Failed with status ${res.status}`);
					}

					setStatus('Message sent successfully!', 'success');
				} catch (err: any) {
					console.error('Error sending message:', err);
					setStatus(`Error: ${err.message}`, 'error', false);
				} finally {
					sendBtn.textContent = 'Send Message';
					updateSendButtonState();
				}
			}

			function updatePreview() {
				if (!input || !output) return;
				const text = input.value;
				if (charCount) {
					charCount.textContent = `${text.length} character${text.length === 1 ? '' : 's'}`;
				}
				output.innerHTML = parseDiscordMarkdown(text);
				attachSpoilerListeners();
				updateSendButtonState();
			}

			function attachSpoilerListeners() {
				if (!output) return;
				const spoilers = output.querySelectorAll('.discord-spoiler');
				spoilers.forEach((spoiler) => {
					spoiler.addEventListener('click', () => {
						spoiler.classList.add('revealed');
					});
					spoiler.addEventListener('keydown', (e) => {
						const event = e as KeyboardEvent;
						if (event.key === 'Enter' || event.key === ' ') {
							spoiler.classList.add('revealed');
						}
					});
				});
			}

			if (input) {
				input.addEventListener('input', updatePreview);
				updatePreview();
			}

			async function pingBackend() {
				const baseUrl = getBackendBaseUrl();
				setStatus('Pinging backend (/ping)...', 'info', false);
				try {
					const res = await fetch(`${baseUrl}/ping`);
					const data = await res.json().catch(() => ({}));
					if (res.ok) {
						setStatus(`✓ Marco Polo Success! Backend replied: ${JSON.stringify(data)}`, 'success', false);
					} else {
						setStatus(`Backend returned status ${res.status}`, 'error', false);
					}
				} catch (err: any) {
					console.error('Ping error:', err);
					const msg = err.name === 'TypeError'
						? `CORS / Network Error: Could not reach ${baseUrl}/ping`
						: err.message;
					setStatus(`Ping Failed: ${msg}`, 'error', false);
				}
			}

			if (pingBtn) {
				pingBtn.addEventListener('click', pingBackend);
			}

			if (channelSelect) {
				channelSelect.addEventListener('change', updateSendButtonState);
			}

			if (refreshBtn) {
				refreshBtn.addEventListener('click', loadChannels);
			}

			if (sendBtn) {
				sendBtn.addEventListener('click', sendMessage);
			}

			if (loginBtn) {
				loginBtn.addEventListener('click', startLogin);
			}

			if (logoutBtn) {
				logoutBtn.addEventListener('click', logout);
			}

			updateAuthUI();
			loadChannels();
		</script>
	</body>
</html>
