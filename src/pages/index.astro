							<button type="button" class="util-btn" data-format="italic" title="Italics (*text*) — Ctrl+I" aria-label="Italics">
								<em style="font-size: 0.95rem; font-family: serif;">I</em>
							</button>
							<button type="button" class="util-btn" data-format="underline" title="Underline (__text__) — Ctrl+U" aria-label="Underline">
								<u style="font-size: 0.95rem;">U</u>
							</button>
							<button type="button" class="util-btn" data-format="strikethrough" title="Strikethrough (~~text~~) — Ctrl+Shift+S" aria-label="Strikethrough">
								<s style="font-size: 0.95rem;">S</s>
							</button>

							<div class="util-divider"></div>

							<button type="button" class="util-btn" data-format="h1" title="Heading 1 (# text)" aria-label="Heading 1">
								<span style="font-size: 0.78rem; font-weight: 700;">H1</span>
							</button>
							<button type="button" class="util-btn" data-format="h2" title="Heading 2 (## text)" aria-label="Heading 2">
								<span style="font-size: 0.78rem; font-weight: 700;">H2</span>
							</button>
							<button type="button" class="util-btn" data-format="h3" title="Heading 3 (### text)" aria-label="Heading 3">
								<span style="font-size: 0.78rem; font-weight: 700;">H3</span>
							</button>
							<button type="button" class="util-btn" data-format="subtext" title="Subtext (-# text)" aria-label="Subtext">
								<span style="font-size: 0.72rem; font-weight: 700;">-#</span>
							</button>

							<div class="util-divider"></div>

							<button type="button" class="util-btn" data-format="quote" title="Quote (> text)" aria-label="Quote">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M3 21c3 0 7-1 7-8V5c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v6c0 4 2 8 5 10z"></path>
									<path d="M17 21c3 0 7-1 7-8V5c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v6c0 4 2 8 5 10z"></path>
								</svg>
							</button>
							<button type="button" class="util-btn" data-format="code" title="Inline Code (`text`) — Ctrl+Shift+C" aria-label="Inline Code">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<polyline points="16 18 22 12 16 6"></polyline>
									<polyline points="8 6 2 12 8 18"></polyline>
								</svg>
							</button>
							<button type="button" class="util-btn" data-format="codeblock" title="Code Block (```text```)" aria-label="Code Block">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
									<path d="m8 10 2 2-2 2"></path>
									<line x1="12" y1="14" x2="16" y2="14"></line>
								</svg>
							</button>

							<div class="util-divider"></div>

							<button type="button" class="util-btn" data-format="ul" title="Bulleted List (- item)" aria-label="Bulleted List">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<line x1="9" y1="6" x2="20" y2="6"></line>
									<line x1="9" y1="12" x2="20" y2="12"></line>
									<line x1="9" y1="18" x2="20" y2="18"></line>
									<circle cx="4" cy="6" r="1.5" fill="currentColor"></circle>
									<circle cx="4" cy="12" r="1.5" fill="currentColor"></circle>
									<circle cx="4" cy="18" r="1.5" fill="currentColor"></circle>
								</svg>
							</button>
							<button type="button" class="util-btn" data-format="ol" title="Numbered List (1. item)" aria-label="Numbered List">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<line x1="10" y1="6" x2="21" y2="6"></line>
									<line x1="10" y1="12" x2="21" y2="12"></line>
									<line x1="10" y1="18" x2="21" y2="18"></line>
									<path d="M4 6h1v4"></path>
									<path d="M4 10h2"></path>
									<path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"></path>
								</svg>
							</button>

							<div class="util-divider"></div>

							<button type="button" class="util-btn" data-format="spoiler" title="Spoiler (||text||)" aria-label="Spoiler">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
									<line x1="1" y1="1" x2="23" y2="23"></line>
								</svg>
							</button>
							<button type="button" class="util-btn" data-format="link" title="Link ([label](url)) — Ctrl+K" aria-label="Link">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
									<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
								</svg>
							</button>
						</div>

						<textarea
							id="markdown-input"
							placeholder="Type Discord markdown here..."
							spellcheck="false"
						>{initialMarkdown}</textarea>
					</div>
				</div>
			</section>

			<section class="panel">
				<div class="panel-header">
					<div class="panel-title">
						<span>Output</span>
						<span class="badge">Live Preview</span>
					</div>
					<span>Formatted</span>
				</div>
				<div class="preview-wrapper">
					<div id="markdown-output" set:html={initialHtml}></div>
					<div id="preview-image-container" class="preview-attachment">
						<img id="preview-image" src="" alt="attachment preview" />
					</div>
				</div>
			</section>
		</main>

		<script>
			import { parseDiscordMarkdown } from '../utils/discordMarkdown';

			const input = document.getElementById('markdown-input') as HTMLTextAreaElement | null;
			const output = document.getElementById('markdown-output');
			const charCount = document.getElementById('char-count');
			const channelSelect = document.getElementById('channel-select') as HTMLSelectElement | null;
			const refreshBtn = document.getElementById('refresh-btn') as HTMLButtonElement | null;
			const sendBtn = document.getElementById('send-btn') as HTMLButtonElement | null;
			const statusMsg = document.getElementById('status-msg');

			const fileChooseBtn = document.getElementById('file-choose-btn') as HTMLButtonElement | null;
			const imageFileInput = document.getElementById('image-file-input') as HTMLInputElement | null;
			const fileNameDisplay = document.getElementById('file-name-display');
			const imageClearBtn = document.getElementById('image-clear-btn') as HTMLButtonElement | null;
			const previewImageContainer = document.getElementById('preview-image-container');
			const previewImage = document.getElementById('preview-image') as HTMLImageElement | null;

			const messageIdInput = document.getElementById('message-id-input') as HTMLInputElement | null;
			const loadMsgBtn = document.getElementById('load-msg-btn') as HTMLButtonElement | null;
			const editModeIndicator = document.getElementById('edit-mode-indicator');
			const editingMessageIdSpan = document.getElementById('editing-message-id');
			const cancelEditBtn = document.getElementById('cancel-edit-btn') as HTMLButtonElement | null;

			let editingMessageId: string | null = null;
			let existingAttachmentUrl: string | null = null;
			let removeAttachmentOnEdit: boolean = false;

			let selectedFile: File | null = null;
			let objectUrl: string | null = null;

			const loginBtn = document.getElementById('login-btn') as HTMLButtonElement | null;
			const userChip = document.getElementById('user-chip');
			const userAvatar = document.getElementById('user-avatar') as HTMLImageElement | null;
			const userName = document.getElementById('user-name');
			const logoutBtn = document.getElementById('logout-btn') as HTMLButtonElement | null;

			// Fixed API backend URL
			const BACKEND_BASE_URL = 'https://api.darketomaly.com';

			function getBackendBaseUrl(): string {
				return BACKEND_BASE_URL;
			}

			function setStatus(text: string, type: 'info' | 'success' | 'error' = 'info', autoClear = true) {
				if (!statusMsg) return;
				statusMsg.className = `status-bar ${type}`;
				statusMsg.textContent = text;
				statusMsg.style.display = 'block';

				if (autoClear && type !== 'info') {
					setTimeout(() => {
						if (statusMsg.textContent === text) {
							statusMsg.style.display = 'none';
						}
					}, 4000);
				}
			}

			function getStoredUser() {
				const token = localStorage.getItem('discord_user_token');
				const profileStr = localStorage.getItem('discord_user_profile');
				if (!token || !profileStr) return null;
				try {
					return { token, profile: JSON.parse(profileStr) };
				} catch {
					return null;
				}
			}

			function updateAuthUI() {
				const user = getStoredUser();
				if (user) {
					if (loginBtn) loginBtn.style.display = 'none';
					if (userChip) userChip.style.display = 'flex';
					if (userName) userName.textContent = user.profile.global_name || user.profile.username || 'Discord User';
					if (userAvatar) {
						if (user.profile.avatar) {
							userAvatar.src = `https://cdn.discordapp.com/avatars/${user.profile.id}/${user.profile.avatar}.png?size=64`;
						} else {
							userAvatar.src = 'https://cdn.discordapp.com/embed/avatars/0.png';
						}
					}
				} else {
					if (loginBtn) loginBtn.style.display = 'flex';
					if (userChip) userChip.style.display = 'none';
				}
			}

			async function startLogin() {
				const baseUrl = getBackendBaseUrl();
				const redirectUri = window.location.origin + '/auth/callback';
				setStatus('Getting Discord authorization URL...', 'info', false);

				try {
					const targetUrl = `${baseUrl}/discord/auth/url?redirect_uri=${encodeURIComponent(redirectUri)}`;
					const res = await fetch(targetUrl);
					const data = await res.json().catch(() => ({}));
					if (!res.ok || !data.url) {
						throw new Error(data.error || `HTTP ${res.status} from ${targetUrl}`);
					}
					window.location.href = data.url;
				} catch (err: any) {
					console.error('Login error:', err);
					const msg = err.name === 'TypeError'
						? `CORS / Network Error: Could not reach ${baseUrl}/discord/auth/url`
						: err.message;
					setStatus(`OAuth Error: ${msg}`, 'error', false);
				}
			}

			function logout() {
				localStorage.removeItem('discord_user_token');
				localStorage.removeItem('discord_user_profile');
				updateAuthUI();
				loadChannels();
			}

			async function loadChannels() {
				if (!channelSelect) return;
				const user = getStoredUser();

				if (!user) {
					channelSelect.disabled = true;
					channelSelect.innerHTML = '<option value="">Log in with Discord to select a channel</option>';
					setStatus('Please log in with Discord to view your admin servers and channels.', 'info', false);
					updateSendButtonState();
					return;
				}

				channelSelect.disabled = true;
				channelSelect.innerHTML = '<option value="">Loading channels...</option>';
				const baseUrl = getBackendBaseUrl();
				const endpoint = `${baseUrl}/discord/user-channels`;
				const headers: Record<string, string> = {};
				headers['Authorization'] = `Bearer ${user.token}`;
				setStatus(`Loading channels for @${user.profile.username}...`, 'info', false);

				try {
					const res = await fetch(endpoint, { headers });
					if (res.status === 401 && user) {
						// Token expired or invalid
						logout();
						throw new Error('Discord login expired. Please log in again.');
					}

					if (!res.ok) {
						const errData = await res.json().catch(() => ({}));
						throw new Error(errData.error || `HTTP ${res.status} (${res.statusText || 'Error'})`);
					}

					const guilds = await res.json();
					channelSelect.innerHTML = '';

					if (!Array.isArray(guilds) || guilds.length === 0) {
						channelSelect.innerHTML = '<option value="">No admin servers available</option>';
						setStatus('No servers found where you are an Admin and the bot is present.', 'error', false);
						updateSendButtonState();
						return;
					}

					const defaultOpt = document.createElement('option');
					defaultOpt.value = '';
					defaultOpt.textContent = '-- Select a channel --';
					channelSelect.appendChild(defaultOpt);

					let totalChannels = 0;
					guilds.forEach((guild: any) => {
						const optgroup = document.createElement('optgroup');
						optgroup.label = guild.name;

						guild.channels?.forEach((channel: any) => {
							totalChannels++;
							const opt = document.createElement('option');
							opt.value = channel.id;
							const categoryPrefix = channel.category ? `[${channel.category}] ` : '';
							opt.textContent = `# ${categoryPrefix}${channel.name}`;
							optgroup.appendChild(opt);
						});

						channelSelect.appendChild(optgroup);
					});

					channelSelect.disabled = false;
					setStatus(`✓ Connected: Loaded ${guilds.length} servers & ${totalChannels} channels`, 'success');
					updateSendButtonState();
				} catch (err: any) {
					channelSelect.innerHTML = '<option value="">Failed to connect</option>';
					const detail = err.name === 'TypeError'
						? `CORS / Network Error: Could not reach ${baseUrl}`
						: err.message;
					setStatus(`Error: ${detail}`, 'error', false);
					updateSendButtonState();
				}
			}

			function setEditMode(msgId: string | null) {
				editingMessageId = msgId;
				removeAttachmentOnEdit = false;
				if (editingMessageId) {
					if (editModeIndicator) editModeIndicator.style.display = 'flex';
					if (editingMessageIdSpan) editingMessageIdSpan.textContent = editingMessageId;
					if (sendBtn) {
						const span = sendBtn.querySelector('span');
						if (span) span.textContent = 'Update Message';
						else sendBtn.textContent = 'Update Message';
					}
				} else {
					if (editModeIndicator) editModeIndicator.style.display = 'none';
					if (editingMessageIdSpan) editingMessageIdSpan.textContent = '';
					existingAttachmentUrl = null;
					removeAttachmentOnEdit = false;
					if (sendBtn) {
						const span = sendBtn.querySelector('span');
						if (span) span.textContent = 'Send Message';
						else sendBtn.textContent = 'Send Message';
					}
				}
				updateSendButtonState();
			}

			function updateSendButtonState() {
				if (!sendBtn || !channelSelect || !input) return;
				const hasChannel = Boolean(channelSelect.value);
				const hasText = input.value.trim().length > 0;
				const hasFile = Boolean(selectedFile);
				const hasExistingAttachment = Boolean(existingAttachmentUrl);

				if (editingMessageId) {
					sendBtn.disabled = !hasChannel || (!hasText && !hasFile && !hasExistingAttachment && !removeAttachmentOnEdit);
				} else {
					sendBtn.disabled = !hasChannel || (!hasText && !hasFile);
				}
			}

			function handleFileSelection(file: File | null) {
				if (objectUrl) {
					URL.revokeObjectURL(objectUrl);
					objectUrl = null;
				}

				selectedFile = file;

				if (selectedFile) {
					existingAttachmentUrl = null;
					removeAttachmentOnEdit = false;
					if (fileNameDisplay) fileNameDisplay.textContent = `${selectedFile.name} (${(selectedFile.size / 1024).toFixed(1)} KB)`;
					if (imageClearBtn) imageClearBtn.style.display = 'block';

					objectUrl = URL.createObjectURL(selectedFile);
					if (previewImage) previewImage.src = objectUrl;
					if (previewImageContainer) previewImageContainer.style.display = 'block';
				} else {
					if (existingAttachmentUrl) {
						if (fileNameDisplay) fileNameDisplay.textContent = 'Current attachment retained';
						if (imageClearBtn) imageClearBtn.style.display = 'block';
						if (previewImageContainer) previewImageContainer.style.display = 'block';
						if (previewImage) previewImage.src = existingAttachmentUrl;
					} else {
						if (editingMessageId && removeAttachmentOnEdit) {
							if (fileNameDisplay) fileNameDisplay.textContent = 'Image will be removed on update';
						} else {
							if (fileNameDisplay) fileNameDisplay.textContent = 'No image selected';
						}
						if (imageClearBtn) imageClearBtn.style.display = 'none';
						if (previewImageContainer) previewImageContainer.style.display = 'none';
						if (previewImage) previewImage.src = '';
					}
					if (imageFileInput) imageFileInput.value = '';
				}

				updateSendButtonState();
			}

			function clearAttachment() {
				if (editingMessageId && (existingAttachmentUrl || selectedFile)) {
					removeAttachmentOnEdit = true;
				}
				existingAttachmentUrl = null;
				handleFileSelection(null);
			}

			async function loadMessage() {
				if (!channelSelect?.value) {
					setStatus('Please select a channel first.', 'error');
					return;
				}

				const messageId = messageIdInput?.value?.trim();
				if (!messageId) {
					setStatus('Please enter a Discord Message ID to load.', 'error');
					return;
				}

				const user = getStoredUser();
				if (!user || !user.token) {
					setStatus('Please log in with Discord first to load messages.', 'error');
					return;
				}

				const channelId = channelSelect.value;
				const baseUrl = getBackendBaseUrl();

				if (loadMsgBtn) loadMsgBtn.disabled = true;
				setStatus(`Loading message ${messageId}...`, 'info', false);

				try {
					const res = await fetch(`${baseUrl}/discord/message?channelId=${encodeURIComponent(channelId)}&messageId=${encodeURIComponent(messageId)}`, {
						headers: {
							'Authorization': `Bearer ${user.token}`
						}
					});

					const data = await res.json().catch(() => ({}));
					if (!res.ok) {
						throw new Error(data.error || `Failed with status ${res.status}`);
					}

					if (!data.isBotMessage) {
						setStatus('Warning: Loaded message was not sent by the bot (only bot messages can be edited).', 'error', false);
					} else {
						setStatus(`✓ Loaded message ${messageId}`, 'success');
					}

					if (input) {
						input.value = data.content || '';
						updatePreview();
					}

					setEditMode(messageId);

					// Handle attachments
					if (data.attachments && data.attachments.length > 0) {
						const firstAtt = data.attachments[0];
						existingAttachmentUrl = firstAtt.url;
						if (fileNameDisplay) fileNameDisplay.textContent = `Attached: ${firstAtt.filename} (retained)`;
						if (imageClearBtn) imageClearBtn.style.display = 'block';
						if (previewImage) previewImage.src = firstAtt.url;
						if (previewImageContainer) previewImageContainer.style.display = 'block';
					} else {
						clearAttachment();
					}
				} catch (err: any) {
					console.error('Error loading message:', err);
					setStatus(`Error: ${err.message}`, 'error', false);
				} finally {
					if (loadMsgBtn) loadMsgBtn.disabled = false;
					updateSendButtonState();
				}
			}

			async function sendOrEditMessage() {
				if (!channelSelect?.value) return;
				const hasText = Boolean(input?.value.trim());
				if (!hasText && !selectedFile && !existingAttachmentUrl) return;
				if (!sendBtn) return;

				const channelId = channelSelect.value;
				const content = input?.value || '';
				const baseUrl = getBackendBaseUrl();
				const user = getStoredUser();

				sendBtn.disabled = true;
				const isEditing = Boolean(editingMessageId);
				const endpoint = isEditing ? `${baseUrl}/discord/edit` : `${baseUrl}/discord/send`;

				sendBtn.textContent = isEditing ? 'Updating...' : 'Sending...';
				setStatus(isEditing ? 'Updating Discord message...' : 'Sending message to Discord...', 'info', false);

				try {
					const headers: Record<string, string> = {};
					if (user && user.token) {
						headers['Authorization'] = `Bearer ${user.token}`;
					}

					let body: any;
					if (selectedFile) {
						const formData = new FormData();
						formData.append('channelId', channelId);
						formData.append('content', content);
						if (isEditing && editingMessageId) {
							formData.append('messageId', editingMessageId);
						}
						formData.append('file', selectedFile, selectedFile.name);
						body = formData;
					} else {
						headers['Content-Type'] = 'application/json';
						const payload: Record<string, any> = { channelId, content };
						if (isEditing && editingMessageId) {
							payload['messageId'] = editingMessageId;
							if (removeAttachmentOnEdit) {
								payload['removeAttachment'] = true;
							}
						}
						body = JSON.stringify(payload);
					}

					const res = await fetch(endpoint, {
						method: 'POST',
						headers,
						body: body
					});

					const result = await res.json().catch(() => ({}));
					if (!res.ok) {
						throw new Error(result.error || `Failed with status ${res.status}`);
					}

					setStatus(isEditing ? 'Message updated successfully!' : 'Message sent successfully!', 'success');
					
					if (isEditing) {
						if (removeAttachmentOnEdit) {
							removeAttachmentOnEdit = false;
						}
						if (selectedFile) {
							handleFileSelection(null);
						}
					} else {
						// Clear selected file after successful send
						handleFileSelection(null);
					}
				} catch (err: any) {
					console.error('Error sending/editing message:', err);
					setStatus(`Error: ${err.message}`, 'error', false);
				} finally {
					if (sendBtn) {
						sendBtn.textContent = editingMessageId ? 'Update Message' : 'Send Message';
					}
					updateSendButtonState();
				}
			}

			function replaceText(
				newText: string,
				selStart: number,
				selEnd: number,
				cursorSelectStart?: number,
				cursorSelectEnd?: number
			) {
				if (!input) return;
				input.focus();
				input.setSelectionRange(selStart, selEnd);

				let success = false;
				try {
					success = document.execCommand('insertText', false, newText);
				} catch {
					success = false;
				}
				if (!success) {
					input.setRangeText(newText, selStart, selEnd, 'end');
				}

				if (cursorSelectStart !== undefined && cursorSelectEnd !== undefined) {
					input.setSelectionRange(cursorSelectStart, cursorSelectEnd);
				}
				updatePreview();
			}

			function applyInlineFormat(prefix: string, suffix: string = prefix, placeholder: string = 'text') {
				if (!input) return;
				const start = input.selectionStart;
				const end = input.selectionEnd;
				const val = input.value;
				const selected = val.substring(start, end);

				let hasWrapping =
					selected.startsWith(prefix) &&
					selected.endsWith(suffix) &&
					selected.length >= prefix.length + suffix.length;

				let isSurrounded =
					start >= prefix.length &&
					end + suffix.length <= val.length &&
					val.substring(start - prefix.length, start) === prefix &&
					val.substring(end, end + suffix.length) === suffix;

				// Disambiguate single-asterisk italic from double-asterisk bold
				if (prefix === '*' && suffix === '*') {
					if (hasWrapping && selected.startsWith('**') && selected.endsWith('**')) {
						hasWrapping = false;
					}
					if (isSurrounded) {
						const beforeChar = start >= 2 ? val.charAt(start - 2) : '';
						const afterChar = end + 1 < val.length ? val.charAt(end + 1) : '';
						if (beforeChar === '*' || afterChar === '*') {
							isSurrounded = false;
						}
					}
				}

				if (hasWrapping) {
					const unwrapped = selected.slice(prefix.length, -suffix.length);
					replaceText(unwrapped, start, end, start, start + unwrapped.length);
				} else if (isSurrounded) {
					const unwrapped = selected;
					replaceText(
						unwrapped,
						start - prefix.length,
						end + suffix.length,
						start - prefix.length,
						start - prefix.length + unwrapped.length
					);
				} else if (selected.length > 0) {
					const wrapped = `${prefix}${selected}${suffix}`;
					replaceText(wrapped, start, end, start + prefix.length, start + prefix.length + selected.length);
				} else {
					const wrapped = `${prefix}${placeholder}${suffix}`;
					replaceText(wrapped, start, end, start + prefix.length, start + prefix.length + placeholder.length);
				}
			}

			function applyCodeBlock() {
				if (!input) return;
				const start = input.selectionStart;
				const end = input.selectionEnd;
				const val = input.value;
				const selected = val.substring(start, end);

				if (selected.startsWith('```') && selected.endsWith('```') && selected.length >= 6) {
					let inner = selected.slice(3, -3);
					if (inner.startsWith('\n')) inner = inner.slice(1);
					if (inner.endsWith('\n')) inner = inner.slice(0, -1);
					replaceText(inner, start, end, start, start + inner.length);
					return;
				}

				const code = selected || 'code';
				const replacement = `\`\`\`\n${code}\n\`\`\``;
				replaceText(replacement, start, end, start + 4, start + 4 + code.length);
			}

			function applyLinePrefix(prefix: string, placeholder: string = 'text') {
				if (!input) return;
				const start = input.selectionStart;
				const end = input.selectionEnd;
				const val = input.value;
				const selected = val.substring(start, end);

				if (!selected) {
					const isAtLineStart = start === 0 || val.charAt(start - 1) === '\n';
					const linePrefix = isAtLineStart ? '' : '\n';
					const replacement = `${linePrefix}${prefix}${placeholder}`;
					const selectStart = start + linePrefix.length + prefix.length;
					const selectEnd = selectStart + placeholder.length;
					replaceText(replacement, start, end, selectStart, selectEnd);
					return;
				}

				const lineStart = val.lastIndexOf('\n', start - 1) + 1;
				let lineEnd = val.indexOf('\n', end);
				if (lineEnd === -1) lineEnd = val.length;

				const block = val.substring(lineStart, lineEnd);
				const lines = block.split('\n');

				const hasAnyPrefix = lines.some((line) => line.startsWith(prefix));
				const allHavePrefix =
					hasAnyPrefix && lines.every((line) => line.trim().length === 0 || line.startsWith(prefix));

				let newLines: string[];
				if (allHavePrefix) {
					newLines = lines.map((line) => (line.startsWith(prefix) ? line.slice(prefix.length) : line));
				} else {
					newLines = lines.map((line) => {
						let cleanLine = line;
						if (prefix.startsWith('#') || prefix.startsWith('-#')) {
							cleanLine = cleanLine.replace(/^(#{1,3}\s+|-#\s+)/, '');
						} else if (prefix === '> ') {
							cleanLine = cleanLine.replace(/^>\s+/, '');
						} else if (prefix === '- ') {
							cleanLine = cleanLine.replace(/^(-\s+|\d+\.\s+)/, '');
						}
						return prefix + cleanLine;
					});
				}

				const newBlock = newLines.join('\n');
				replaceText(newBlock, lineStart, lineEnd, lineStart, lineStart + newBlock.length);
			}

			function applyNumberedList(placeholder: string = 'List item') {
				if (!input) return;
				const start = input.selectionStart;
				const end = input.selectionEnd;
				const val = input.value;
				const selected = val.substring(start, end);

				if (!selected) {
					const isAtLineStart = start === 0 || val.charAt(start - 1) === '\n';
					const linePrefix = isAtLineStart ? '' : '\n';
					const prefix = '1. ';
					const replacement = `${linePrefix}${prefix}${placeholder}`;
					const selectStart = start + linePrefix.length + prefix.length;
					const selectEnd = selectStart + placeholder.length;
					replaceText(replacement, start, end, selectStart, selectEnd);
					return;
				}

				const lineStart = val.lastIndexOf('\n', start - 1) + 1;
				let lineEnd = val.indexOf('\n', end);
				if (lineEnd === -1) lineEnd = val.length;

				const block = val.substring(lineStart, lineEnd);
				const lines = block.split('\n');

				const hasAnyNumbered = lines.some((line) => /^\d+\.\s+/.test(line));
				const allNumbered =
					hasAnyNumbered && lines.every((line) => line.trim().length === 0 || /^\d+\.\s+/.test(line));

				let newLines: string[];
				if (allNumbered) {
					newLines = lines.map((line) => line.replace(/^\d+\.\s+/, ''));
				} else {
					let counter = 1;
					newLines = lines.map((line) => {
						const cleanLine = line.replace(/^(-\s+|\d+\.\s+)/, '');
						return `${counter++}. ${cleanLine}`;
					});
				}

				const newBlock = newLines.join('\n');
				replaceText(newBlock, lineStart, lineEnd, lineStart, lineStart + newBlock.length);
			}

			function applyLink() {
				if (!input) return;
				const start = input.selectionStart;
				const end = input.selectionEnd;
				const val = input.value;
				const selected = val.substring(start, end);

				if (/^https?:\/\//i.test(selected.trim())) {
					const replacement = `[link](${selected.trim()})`;
					replaceText(replacement, start, end, start + 1, start + 5);
				} else if (selected.length > 0) {
					const replacement = `[${selected}](https://)`;
					replaceText(replacement, start, end, start + selected.length + 3, start + selected.length + 11);
				} else {
					const replacement = `[link text](https://)`;
					replaceText(replacement, start, end, start + 1, start + 10);
				}
			}

			function handleFormat(format: string) {
				switch (format) {
					case 'bold':
						applyInlineFormat('**', '**', 'bold text');
						break;
					case 'italic':
						applyInlineFormat('*', '*', 'italic text');
						break;
					case 'underline':
						applyInlineFormat('__', '__', 'underlined text');
						break;
					case 'strikethrough':
						applyInlineFormat('~~', '~~', 'strikethrough text');
						break;
					case 'h1':
						applyLinePrefix('# ', 'Heading 1');
						break;
					case 'h2':
						applyLinePrefix('## ', 'Heading 2');
						break;
					case 'h3':
						applyLinePrefix('### ', 'Heading 3');
						break;
					case 'subtext':
						applyLinePrefix('-# ', 'subtext');
						break;
					case 'quote':
						applyLinePrefix('> ', 'quote');
						break;
					case 'code':
						applyInlineFormat('`', '`', 'code');
						break;
					case 'codeblock':
						applyCodeBlock();
						break;
					case 'ul':
						applyLinePrefix('- ', 'List item');
						break;
					case 'ol':
						applyNumberedList('List item');
						break;
					case 'spoiler':
						applyInlineFormat('||', '||', 'spoiler');
						break;
					case 'link':
						applyLink();
						break;
				}
			}

			function updatePreview() {
				if (!input || !output) return;
				const text = input.value;
				if (charCount) {
					charCount.textContent = `${text.length} character${text.length === 1 ? '' : 's'}`;
				}
				output.innerHTML = parseDiscordMarkdown(text);
				attachSpoilerListeners();
				updateSendButtonState();
			}

			function attachSpoilerListeners() {
				if (!output) return;
				const spoilers = output.querySelectorAll('.discord-spoiler');
				spoilers.forEach((spoiler) => {
					spoiler.addEventListener('click', () => {
						spoiler.classList.add('revealed');
					});
					spoiler.addEventListener('keydown', (e) => {
						const event = e as KeyboardEvent;
						if (event.key === 'Enter' || event.key === ' ') {
							spoiler.classList.add('revealed');
						}
					});
				});
			}

			const utilityBar = document.getElementById('text-utility-bar');
			if (utilityBar) {
				utilityBar.addEventListener('mousedown', (e) => {
					// Prevent losing selection inside textarea
					const target = (e.target as HTMLElement).closest('.util-btn');
					if (target) {
						e.preventDefault();
					}
				});

				utilityBar.addEventListener('click', (e) => {
					const btn = (e.target as HTMLElement).closest('.util-btn') as HTMLElement | null;
					if (!btn) return;
					const format = btn.getAttribute('data-format');
					if (format) {
						handleFormat(format);
					}
				});
			}

			if (input) {
				input.addEventListener('input', updatePreview);
				input.addEventListener('keydown', (e) => {
					const isMod = e.ctrlKey || e.metaKey;
					if (!isMod) return;

					const key = e.key.toLowerCase();
					if (key === 'b') {
						e.preventDefault();
						handleFormat('bold');
					} else if (key === 'i') {
						e.preventDefault();
						handleFormat('italic');
					} else if (key === 'u') {
						e.preventDefault();
						handleFormat('underline');
					} else if (key === 'k') {
						e.preventDefault();
						handleFormat('link');
					} else if (e.shiftKey && (key === 'x' || key === 's')) {
						e.preventDefault();
						handleFormat('strikethrough');
					} else if (e.shiftKey && key === 'c') {
						e.preventDefault();
						handleFormat('code');
					}
				});
				updatePreview();
			}

			if (fileChooseBtn && imageFileInput) {
				fileChooseBtn.addEventListener('click', () => imageFileInput.click());
				imageFileInput.addEventListener('change', () => {
					const file = imageFileInput.files?.[0] || null;
					handleFileSelection(file);
				});
			}

			if (imageClearBtn) {
				imageClearBtn.addEventListener('click', () => {
					clearAttachment();
				});
			}

			if (channelSelect) {
				channelSelect.addEventListener('change', updateSendButtonState);
			}

			if (refreshBtn) {
				refreshBtn.addEventListener('click', loadChannels);
			}

			if (sendBtn) {
				sendBtn.addEventListener('click', sendOrEditMessage);
			}

			if (loadMsgBtn) {
				loadMsgBtn.addEventListener('click', loadMessage);
			}

			if (cancelEditBtn) {
				cancelEditBtn.addEventListener('click', () => {
					setEditMode(null);
					clearAttachment();
					if (messageIdInput) messageIdInput.value = '';
					setStatus('Switched back to new message mode.', 'info');
				});
			}

			if (messageIdInput) {
				messageIdInput.addEventListener('keydown', (e) => {
					if (e.key === 'Enter') {
						e.preventDefault();
						loadMessage();
					}
				});
			}

			if (loginBtn) {
				loginBtn.addEventListener('click', startLogin);
			}

			if (logoutBtn) {
				logoutBtn.addEventListener('click', logout);
			}

			updateAuthUI();
			loadChannels();
		</script>
	</body>
</html>
