---
import { parseDiscordMarkdown } from '../utils/discordMarkdown';

const initialMarkdown = `Hello **world**! Welcome to the Discord markdown previewer.

Here are some examples of what you can type:
- **Bold text** with \`**bold**\`
- *Italic text* with \`*italic*\` or _italic_ with \`_italic_\`
- ***Bold & Italic*** with \`***text***\`
- __Underlined text__ with \`__text__\`
- ~~Strikethrough~~ with \`~~text~~\`
- ||Spoiler alert: Click to reveal!|| with \`||spoiler||\`
- Inline code like \`const x = 42;\`
- Subtext with -# small details:
-# This is quiet subtext!

### Headers
# Big Header (H1)
## Medium Header (H2)
### Small Header (H3)

> Single line blockquote
> Second line of quote

\`\`\`javascript
function greet(name) {
  console.log("Hello, " + name + "!");
}
\`\`\`

Check out [Astro](https://astro.build) or raw link https://discord.com!`;

const initialHtml = parseDiscordMarkdown(initialMarkdown);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>Discord Markdown Previewer</title>
		<style>
			:root {
				--bg-app: #1e1f22;
				--bg-header: #2b2d31;
				--bg-editor: #313338;
				--bg-preview: #313338;
				--bg-input: #383a40;
				--text-normal: #dbdee1;
				--text-muted: #949ba4;
				--text-header: #f2f3f5;
				--text-link: #00a8fc;
				--code-bg: #2b2d31;
				--quote-border: #4e5058;
				--spoiler-bg: #242429;
				--spoiler-revealed: #2b2d31;
				--border-color: #1f2023;
				--accent: #5865f2;
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family: "gg sans", "Noto Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
				background-color: var(--bg-app);
				color: var(--text-normal);
				display: flex;
				flex-direction: column;
				height: 100vh;
				overflow: hidden;
			}

			header {
				background-color: var(--bg-header);
				padding: 12px 24px;
				display: flex;
				align-items: center;
				justify-content: space-between;
				border-bottom: 1px solid var(--border-color);
				box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
			}

			header h1 {
				font-size: 1.15rem;
				font-weight: 700;
				color: var(--text-header);
				display: flex;
				align-items: center;
				gap: 10px;
			}

			header .badge {
				background-color: var(--accent);
				color: #fff;
				font-size: 0.75rem;
				padding: 2px 8px;
				border-radius: 12px;
				font-weight: 600;
			}

			.main-container {
				flex: 1;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 16px;
				padding: 16px;
				min-height: 0;
			}

			@media (max-width: 768px) {
				.main-container {
					grid-template-columns: 1fr;
					grid-template-rows: 1fr 1fr;
				}
			}

			.panel {
				background-color: var(--bg-editor);
				border-radius: 8px;
				display: flex;
				flex-direction: column;
				overflow: hidden;
				box-shadow: 0 4px 6px rgba(0, 0, 0, 0.15);
				border: 1px solid rgba(255, 255, 255, 0.05);
			}

			.panel-header {
				background-color: var(--bg-header);
				padding: 10px 16px;
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--text-muted);
				text-transform: uppercase;
				letter-spacing: 0.5px;
				display: flex;
				align-items: center;
				justify-content: space-between;
				border-bottom: 1px solid var(--border-color);
			}

			.editor-wrapper {
				flex: 1;
				display: flex;
				flex-direction: column;
				padding: 12px;
				gap: 12px;
				min-height: 0;
			}

			.action-bar {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 10px;
				background-color: var(--bg-header);
				padding: 10px 14px;
				border-radius: 6px;
				border: 1px solid rgba(255, 255, 255, 0.05);
			}

			.select-wrapper {
				flex: 1;
				min-width: 200px;
				display: flex;
				align-items: center;
				gap: 8px;
			}

			.select-label {
				font-size: 0.8rem;
				font-weight: 600;
				color: var(--text-muted);
				white-space: nowrap;
			}

			#channel-select {
				flex: 1;
				background-color: var(--bg-input);
				color: var(--text-normal);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 4px;
				padding: 8px 10px;
				font-size: 0.88rem;
				outline: none;
				cursor: pointer;
			}

			#channel-select:focus {
				border-color: var(--accent);
			}

			.btn-refresh {
				background-color: transparent;
				color: var(--text-muted);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 4px;
				padding: 8px 12px;
				font-size: 0.82rem;
				cursor: pointer;
				transition: all 0.15s ease;
			}

			.btn-refresh:hover {
				color: var(--text-header);
				background-color: rgba(255, 255, 255, 0.05);
			}

			.btn-send {
				background-color: var(--accent);
				color: #fff;
				border: none;
				border-radius: 4px;
				padding: 8px 18px;
				font-size: 0.88rem;
				font-weight: 600;
				cursor: pointer;
				transition: opacity 0.15s ease, background-color 0.15s ease;
				display: flex;
				align-items: center;
				gap: 6px;
			}

			.btn-send:hover:not(:disabled) {
				background-color: #4752c4;
			}

			.btn-send:disabled {
				opacity: 0.5;
				cursor: not-allowed;
			}

			.status-bar {
				font-size: 0.8rem;
				padding: 4px 8px;
				border-radius: 4px;
				display: none;
			}

			.status-bar.info {
				display: block;
				color: var(--text-muted);
			}

			.status-bar.success {
				display: block;
				background-color: rgba(46, 204, 113, 0.15);
				color: #2ecc71;
				border: 1px solid rgba(46, 204, 113, 0.3);
			}

			.status-bar.error {
				display: block;
				background-color: rgba(231, 76, 60, 0.15);
				color: #e74c3c;
				border: 1px solid rgba(231, 76, 60, 0.3);
			}

			#markdown-input {
				width: 100%;
				flex: 1;
				background-color: var(--bg-input);
				color: var(--text-normal);
				border: 1px solid transparent;
				border-radius: 6px;
				padding: 14px;
				font-family: "Consolas", "Courier New", Courier, monospace;
				font-size: 0.92rem;
				line-height: 1.5;
				resize: none;
				outline: none;
				transition: border-color 0.15s ease;
			}

			#markdown-input:focus {
				border-color: var(--accent);
			}

			.preview-wrapper {
				flex: 1;
				padding: 16px;
				overflow-y: auto;
				background-color: var(--bg-preview);
				font-size: 0.95rem;
				line-height: 1.45;
				word-break: break-word;
			}

			/* Discord Message Styling */
			:global(.discord-h1) {
				font-size: 1.5rem;
				font-weight: 700;
				color: var(--text-header);
				margin: 12px 0 6px 0;
			}

			:global(.discord-h2) {
				font-size: 1.25rem;
				font-weight: 700;
				color: var(--text-header);
				margin: 10px 0 4px 0;
			}

			:global(.discord-h3) {
				font-size: 1.05rem;
				font-weight: 700;
				color: var(--text-header);
				margin: 8px 0 4px 0;
			}

			:global(.discord-subtext) {
				color: var(--text-muted);
				font-size: 0.8rem;
				display: block;
				margin: 2px 0;
			}

			:global(.discord-quote) {
				border-left: 4px solid var(--quote-border);
				padding-left: 12px;
				margin: 4px 0;
				color: var(--text-normal);
			}

			:global(.discord-inline-code) {
				background-color: var(--code-bg);
				padding: 2px 5px;
				border-radius: 4px;
				font-family: "Consolas", monospace;
				font-size: 0.88em;
				color: var(--text-normal);
			}

			:global(.discord-code-block) {
				background-color: var(--code-bg);
				border: 1px solid rgba(0, 0, 0, 0.2);
				border-radius: 6px;
				padding: 10px 12px;
				margin: 8px 0;
				overflow-x: auto;
				font-family: "Consolas", monospace;
				font-size: 0.88em;
				color: var(--text-normal);
				line-height: 1.4;
			}

			:global(.discord-link) {
				color: var(--text-link);
				text-decoration: none;
			}

			:global(.discord-link:hover) {
				text-decoration: underline;
			}

			:global(.discord-spoiler) {
				background-color: var(--spoiler-bg);
				color: transparent;
				border-radius: 3px;
				padding: 1px 4px;
				cursor: pointer;
				user-select: none;
				transition: background-color 0.1s ease, color 0.1s ease;
			}

			:global(.discord-spoiler.revealed) {
				background-color: var(--spoiler-revealed);
				color: var(--text-normal);
				cursor: text;
				user-select: text;
			}
		</style>
	</head>
	<body>
		<header>
			<h1>Discord Markdown Previewer</h1>
			<span class="badge">Live Preview</span>
		</header>

		<main class="main-container">
			<section class="panel">
				<div class="panel-header">
					<span>Write (Input)</span>
					<span id="char-count">0 characters</span>
				</div>
				<div class="editor-wrapper">
					<div class="action-bar">
						<div class="select-wrapper">
							<label for="backend-url" class="select-label">API:</label>
							<input
								type="text"
								id="backend-url"
								placeholder="https://api.darketomaly.com"
								style="background-color: var(--bg-input); color: var(--text-normal); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 4px; padding: 6px 10px; font-size: 0.85rem; width: 190px;"
							/>
						</div>
						<div class="select-wrapper" style="flex: 2;">
							<label for="channel-select" class="select-label">Channel:</label>
							<select id="channel-select" disabled>
								<option value="">Loading channels...</option>
							</select>
							<button type="button" id="refresh-btn" class="btn-refresh" title="Reload channels">↻</button>
						</div>
						<button type="button" id="send-btn" class="btn-send" disabled>
							<span>Send Message</span>
						</button>
						<div id="status-msg" class="status-bar"></div>
					</div>

					<textarea
						id="markdown-input"
						placeholder="Type Discord markdown here..."
						spellcheck="false"
					>{initialMarkdown}</textarea>
				</div>
			</section>

			<section class="panel">
				<div class="panel-header">
					<span>Read (Discord Preview)</span>
					<span>Formatted</span>
				</div>
				<div class="preview-wrapper" id="markdown-output" set:html={initialHtml}></div>
			</section>
		</main>

		<script>
			import { parseDiscordMarkdown } from '../utils/discordMarkdown';

			const input = document.getElementById('markdown-input') as HTMLTextAreaElement | null;
			const output = document.getElementById('markdown-output');
			const charCount = document.getElementById('char-count');
			const backendUrlInput = document.getElementById('backend-url') as HTMLInputElement | null;
			const channelSelect = document.getElementById('channel-select') as HTMLSelectElement | null;
			const refreshBtn = document.getElementById('refresh-btn') as HTMLButtonElement | null;
			const sendBtn = document.getElementById('send-btn') as HTMLButtonElement | null;
			const statusMsg = document.getElementById('status-msg');

			const DEFAULT_BACKEND_URL = (import.meta as any).env?.PUBLIC_BACKEND_URL || 'https://api.darketomaly.com';

			function getBackendBaseUrl(): string {
				let url = backendUrlInput?.value.trim() || DEFAULT_BACKEND_URL;
				return url.replace(/\/+$/, '');
			}

			if (backendUrlInput) {
				const savedUrl = localStorage.getItem('discord_backend_url');
				backendUrlInput.value = savedUrl || DEFAULT_BACKEND_URL;
				backendUrlInput.addEventListener('change', () => {
					localStorage.setItem('discord_backend_url', backendUrlInput.value.trim());
					loadChannels();
				});
			}

			function setStatus(text: string, type: 'info' | 'success' | 'error' = 'info', autoClear = true) {
				if (!statusMsg) return;
				statusMsg.className = `status-bar ${type}`;
				statusMsg.textContent = text;
				statusMsg.style.display = 'block';

				if (autoClear && type !== 'info') {
					setTimeout(() => {
						if (statusMsg.textContent === text) {
							statusMsg.style.display = 'none';
						}
					}, 4000);
				}
			}

			async function loadChannels() {
				if (!channelSelect) return;
				channelSelect.disabled = true;
				channelSelect.innerHTML = '<option value="">Loading channels...</option>';
				const baseUrl = getBackendBaseUrl();
				setStatus(`Connecting to ${baseUrl}...`, 'info', false);

				try {
					const res = await fetch(`${baseUrl}/discord/channels`);
					if (!res.ok) {
						const errData = await res.json().catch(() => ({}));
						throw new Error(errData.error || `HTTP ${res.status}`);
					}

					const guilds = await res.json();
					channelSelect.innerHTML = '';

					if (!Array.isArray(guilds) || guilds.length === 0) {
						channelSelect.innerHTML = '<option value="">No servers available</option>';
						setStatus('Bot has no servers or is starting up', 'error');
						return;
					}

					const defaultOpt = document.createElement('option');
					defaultOpt.value = '';
					defaultOpt.textContent = '-- Select a channel --';
					channelSelect.appendChild(defaultOpt);

					let totalChannels = 0;
					guilds.forEach((guild: any) => {
						const optgroup = document.createElement('optgroup');
						optgroup.label = guild.name;

						guild.channels?.forEach((channel: any) => {
							totalChannels++;
							const opt = document.createElement('option');
							opt.value = channel.id;
							const categoryPrefix = channel.category ? `[${channel.category}] ` : '';
							opt.textContent = `# ${categoryPrefix}${channel.name}`;
							optgroup.appendChild(opt);
						});

						channelSelect.appendChild(optgroup);
					});

					channelSelect.disabled = false;
					setStatus(`Loaded ${totalChannels} channels`, 'success');
					updateSendButtonState();
				} catch (err: any) {
					console.error('Failed to load channels:', err);
					channelSelect.innerHTML = '<option value="">Failed to connect</option>';
					setStatus(`Backend offline (${err.message})`, 'error', false);
					updateSendButtonState();
				}
			}

			function updateSendButtonState() {
				if (!sendBtn || !channelSelect || !input) return;
				const hasChannel = Boolean(channelSelect.value);
				const hasText = input.value.trim().length > 0;
				sendBtn.disabled = !hasChannel || !hasText;
			}

			async function sendMessage() {
				if (!channelSelect?.value || !input?.value.trim()) return;
				if (!sendBtn) return;

				const channelId = channelSelect.value;
				const content = input.value;
				const baseUrl = getBackendBaseUrl();

				sendBtn.disabled = true;
				sendBtn.textContent = 'Sending...';
				setStatus('Sending message to Discord...', 'info', false);

				try {
					const res = await fetch(`${baseUrl}/discord/send`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ channelId, content })
					});

					const result = await res.json().catch(() => ({}));
					if (!res.ok) {
						throw new Error(result.error || `Failed with status ${res.status}`);
					}

					setStatus('Message sent successfully!', 'success');
				} catch (err: any) {
					console.error('Error sending message:', err);
					setStatus(`Error: ${err.message}`, 'error', false);
				} finally {
					sendBtn.textContent = 'Send Message';
					updateSendButtonState();
				}
			}

			function updatePreview() {
				if (!input || !output) return;
				const text = input.value;
				if (charCount) {
					charCount.textContent = `${text.length} character${text.length === 1 ? '' : 's'}`;
				}
				output.innerHTML = parseDiscordMarkdown(text);
				attachSpoilerListeners();
				updateSendButtonState();
			}

			function attachSpoilerListeners() {
				if (!output) return;
				const spoilers = output.querySelectorAll('.discord-spoiler');
				spoilers.forEach((spoiler) => {
					spoiler.addEventListener('click', () => {
						spoiler.classList.add('revealed');
					});
					spoiler.addEventListener('keydown', (e) => {
						const event = e as KeyboardEvent;
						if (event.key === 'Enter' || event.key === ' ') {
							spoiler.classList.add('revealed');
						}
					});
				});
			}

			if (input) {
				input.addEventListener('input', updatePreview);
				updatePreview();
			}

			if (channelSelect) {
				channelSelect.addEventListener('change', updateSendButtonState);
			}

			if (refreshBtn) {
				refreshBtn.addEventListener('click', loadChannels);
			}

			if (sendBtn) {
				sendBtn.addEventListener('click', sendMessage);
			}

			loadChannels();
		</script>
	</body>
</html>
